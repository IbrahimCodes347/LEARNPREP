NODE_ENV=development
PORT=5000

# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/learnprep

# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_16_chars
JWT_EXPIRES_IN=1d

# Exact frontend origin (no trailing slash, never *)
CLIENT_ORIGIN=http://localhost:5173

# lax by default. Use "none" only when client and API are on different
# domains, which also requires HTTPS.
COOKIE_SAMESITE=lax

# Set false to hide the register page entirely
ALLOW_SELF_REGISTER=true

# Email notifications are off by default. The defaults target Gmail, so for the
# demo you only need EMAIL_ENABLED=true, EMAIL_USER and EMAIL_PASS (an App
# Password, not the account password - see docs/Deployment.md).
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# true only for implicit-TLS ports like 465; Gmail 587 uses STARTTLS (false)
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Optional display sender, e.g. "LearnPrep <noreply@example.com>". Leave empty
# to send from EMAIL_USER.
EMAIL_FROM=

# Used only by `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin